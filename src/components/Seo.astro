---
// Etiquetas para buscadores y para la vista previa al compartir en redes
// (Open Graph para Facebook, LinkedIn, WhatsApp y Twitter/X).
import { getLangFromUrl } from '../i18n/utils';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const lang = getLangFromUrl(Astro.url);
const site = Astro.site ?? new URL('https://minkaspr.com');

const defaults = {
	es: {
		title: 'Dario Quispe · Desarrollador de software',
		description: 'Portafolio de Dario Quispe (Minkaspr), desarrollador de software en Lima, Perú. Aplicaciones web con Angular y Spring Boot, apps Android y bases de datos.',
		image: '/og-es.png',
		imageAlt: 'Dario Quispe, desarrollador de software',
		locale: 'es_PE',
		altLocale: 'en_US',
	},
	en: {
		title: 'Dario Quispe · Software developer',
		description: 'Portfolio of Dario Quispe (Minkaspr), a software developer based in Lima, Peru. Web apps with Angular and Spring Boot, Android apps and databases.',
		image: '/og-en.png',
		imageAlt: 'Dario Quispe, software developer',
		locale: 'en_US',
		altLocale: 'es_PE',
	},
}[lang];

const { title, description = defaults.description, image = defaults.image } = Astro.props;
const fullTitle = title ? `${title} · Dario Quispe` : defaults.title;

// Ruta equivalente en el otro idioma, para hreflang
const path = Astro.url.pathname;
const esPath = path.replace(/^\/en(\/|$)/, '/');
const enPath = esPath === '/' ? '/en/' : `/en${esPath}`;

const canonical = new URL(path, site).href;
const esUrl = new URL(esPath, site).href;
const enUrl = new URL(enPath, site).href;
const imageUrl = new URL(image, site).href;

const person = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Dario Quispe',
	alternateName: 'Minkaspr',
	url: site.href,
	image: new URL('/profile.jpg', site).href,
	jobTitle: lang === 'es' ? 'Desarrollador de software' : 'Software developer',
	address: { '@type': 'PostalAddress', addressLocality: 'Lima', addressCountry: 'PE' },
	sameAs: ['https://github.com/Minkaspr', 'https://www.linkedin.com/in/dario-quispe-mk/'],
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content="Dario Quispe" />
<link rel="canonical" href={canonical} />

<link rel="alternate" hreflang="es" href={esUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={esUrl} />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Minkaspr" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={defaults.imageAlt} />
<meta property="og:locale" content={defaults.locale} />
<meta property="og:locale:alternate" content={defaults.altLocale} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={defaults.imageAlt} />

<!-- Color de la barra del navegador en móviles -->
<meta name="theme-color" content="#0f1417" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#e7ecf1" media="(prefers-color-scheme: light)" />

<script type="application/ld+json" set:html={JSON.stringify(person)} />
