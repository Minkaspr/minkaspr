---
// ThemeToggle: usa data-attribute en lugar de id para evitar el bug de
// IDs duplicados cuando se renderiza tanto en la nav desktop como mobile.
---

<button
  data-theme-toggle
  class="p-2 rounded-lg text-on-surface hover:bg-surface-container transition-colors duration-200"
  aria-label="Cambiar tema"
  type="button"
>
  <!-- Sol → cambia a modo claro (visible en modo oscuro) -->
  <svg data-sun class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M16.95 16.95l.707.707M7.05 7.05l.707.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
  </svg>
  <!-- Luna → cambia a modo oscuro (visible en modo claro) -->
  <svg data-moon class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
      d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
  </svg>
</button>

<script>
  // Usamos querySelectorAll (no getElementById) porque ThemeToggle se renderiza
  // tanto en la nav desktop como en el header mobile → IDs duplicados harían
  // que solo el primero funcione.
  function attachThemeListeners() {
    document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const root = document.documentElement;

        // Alterna la clase 'dark' en <html> y guarda la preferencia
        const isDark = root.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    });
  }

  // Se ejecuta en cada navegación de Astro (View Transitions incluido)
  document.addEventListener('astro:page-load', attachThemeListeners);
</script>