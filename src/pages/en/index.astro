---
import Layout from '../../layouts/Layout.astro';
import StackAreas from '../../components/StackAreas.astro';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';

const t = useTranslations('en');
const translatePath = useTranslatedPath('en');
---

<Layout>
	<!-- Hero Section -->
	<section id="hero-section" class="relative min-h-svh flex items-center pb-10 px-8 md:px-16 overflow-hidden">
		<!-- Animated Architectural Grids -->
		<div class="spotlight-mask-base">
			<div class="architectural-grid"></div>
		</div>
		<div class="spotlight-mask-cursor">
			<div class="architectural-grid"></div>
		</div>

		<div class="w-full max-w-6xl mx-auto grid grid-cols-12 gap-6 lg:gap-12 editorial-grid relative z-10">
			<div class="col-span-12 lg:col-span-8 flex flex-col justify-center">
				<div class="font-headline uppercase tracking-widest text-[11px] sm:text-xs text-primary-container mb-4 sm:mb-6 flex items-center gap-3">
					<span class="material-symbols-outlined text-sm sm:text-base">terminal</span>
					FULL-STACK DEVELOPER · SOFTWARE ENGINEERING GRADUATE
				</div>
				<h1 class="text-4xl sm:text-6xl md:text-8xl font-headline font-bold tracking-tighter leading-none mb-5 sm:mb-8 text-on-surface">
					GIVING SHAPE TO <span class="text-transparent bg-clip-text bg-linear-to-br from-secondary to-primary">CHAOS</span>.
				</h1>
				<p class="text-base sm:text-lg md:text-xl font-body text-on-surface-variant max-w-2xl mb-8 sm:mb-12 leading-relaxed">
					I'm Dario Quispe, from Lima, Peru 🇵🇪. I started coding out of curiosity, and it never wore off. It still surprises me to see a simple idea turn into something other people actually use.
				</p>
				<div class="flex flex-wrap gap-3 sm:gap-6 items-center">
					<a href={translatePath('/projects/')} class="px-5 py-2.5 sm:px-8 sm:py-4 bg-primary-container text-on-primary-container font-headline font-bold text-sm sm:text-base rounded-lg flex items-center gap-2 sm:gap-3 hover:shadow-[0_8px_24px_rgba(0,92,120,0.35)] dark:hover:shadow-[0_0_30px_rgba(79,195,247,0.4)] transition-all">
						VIEW PROJECTS
						<span class="material-symbols-outlined text-lg sm:text-xl">arrow_forward</span>
					</a>
					<a href="https://www.linkedin.com/in/dario-quispe-mk/" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 sm:px-8 sm:py-4 bg-surface border border-outline-variant/20 text-on-surface font-headline font-medium text-sm sm:text-base rounded-lg flex items-center gap-2 sm:gap-3 hover:bg-surface-container-low transition-colors">
						LINKEDIN
						<span class="material-symbols-outlined text-base sm:text-lg">open_in_new</span>
					</a>
				</div>
			</div>
			<!-- Hero Visual Element -->
			<div class="col-span-12 lg:col-span-4 relative mt-12 lg:mt-0 flex justify-center items-center min-w-0">
				<div class="relative w-72 h-72 md:w-96 md:h-96 lg:w-64 lg:h-64 xl:w-72 xl:h-72 group">
					<div class="absolute inset-0 bg-primary-container rounded-full mix-blend-multiply dark:mix-blend-screen filter blur-3xl opacity-20 group-hover:opacity-40 transition-opacity"></div>

					<!-- Solid ring — the gradient's starting line -->
					<div class="absolute -inset-[4%] border border-primary-container/35 rounded-full animate-spin-slow"></div>

					<!-- Dashed ring -->
					<svg class="absolute -inset-[7%] w-[114%] h-[114%] ring-dashed" viewBox="0 0 100 100">
						<circle cx="50" cy="50" r="48" fill="none" stroke="var(--color-primary-container)" stroke-width="0.6" stroke-dasharray="5 6" stroke-linecap="round" opacity="0.22"/>
					</svg>

					<!-- Dotted ring -->
					<svg class="absolute -inset-[11%] w-[122%] h-[122%] ring-dotted" viewBox="0 0 100 100">
						<circle cx="50" cy="50" r="49" fill="none" stroke="var(--color-primary-container)" stroke-width="1.6" stroke-dasharray="0.4 6" stroke-linecap="round" opacity="0.12"/>
					</svg>

					<div class="w-full h-full rounded-full border-4 border-surface-container relative z-10 overflow-hidden bg-[#F6F6F7] flex items-center justify-center">
						<img alt="Dario Quispe" class="w-full h-full object-contain" src="/profile.jpg"/>
					</div>

					<!-- Floating tech badges -->
					<div class="hero-badge absolute -top-3 left-4 w-16 h-16 rounded-full bg-surface-container-highest border border-border-subtle shadow-(--shadow-elevated) flex items-center justify-center z-20" style="animation-delay:0s">
						<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-original.svg" alt="Node.js" class="w-8 h-8" />
					</div>
					<div class="hero-badge absolute top-1/4 -right-8 w-14 h-14 rounded-full bg-surface-container-highest border border-border-subtle shadow-(--shadow-elevated) flex items-center justify-center z-20" style="animation-delay:0.9s">
						<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/java/java-original.svg" alt="Java" class="w-7 h-7" />
					</div>
					<div class="hero-badge absolute -bottom-3 right-6 w-16 h-16 rounded-full bg-surface-container-highest border border-border-subtle shadow-(--shadow-elevated) flex items-center justify-center z-20" style="animation-delay:1.8s">
						<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg" alt="Python" class="w-8 h-8" />
					</div>
					<div class="hero-badge absolute bottom-1/4 -left-9 w-14 h-14 rounded-full bg-surface-container-highest border border-border-subtle shadow-(--shadow-elevated) flex items-center justify-center z-20" style="animation-delay:2.7s">
						<img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg" alt="PostgreSQL" class="w-7 h-7" />
					</div>
				</div>
			</div>

			<!-- Background Decorative Text (Aislado al contenido, no a la pantalla) -->
			<div class="absolute -bottom-10 sm:-bottom-16 md:-bottom-28 right-0 md:-right-10 lg:-right-20 text-[3.5rem] sm:text-[5.5rem] md:text-[8rem] lg:text-[10rem] font-headline font-black text-on-surface/8 select-none pointer-events-none -z-10">
				INERTIA
			</div>
		</div>
	</section>

	<!-- Lo que hago: áreas destacadas -->
	<StackAreas lang="en" />

	<script>
		import { animate, inView, stagger } from "motion";

		document.addEventListener("astro:page-load", () => {
			// Este listener queda activo en toda la navegación: solo actúa en el inicio
			if (!document.getElementById("hero-section")) return;

			// Funcionalidad del Spotlight del Grid
			const heroSection = document.getElementById("hero-section");
			if (heroSection) {
				heroSection.addEventListener("mousemove", (e) => {
					const rect = heroSection.getBoundingClientRect();
					const x = e.clientX - rect.left;
					const y = e.clientY - rect.top;
					heroSection.style.setProperty("--mouse-x", `${x}px`);
					heroSection.style.setProperty("--mouse-y", `${y}px`);
				});
			}

			// Hero Animation
			const heroTitle = document.querySelectorAll<HTMLElement>(".editorial-grid > div");
			if (heroTitle.length > 0) {
				heroTitle.forEach((el) => (el.style.opacity = "0"));
				animate(heroTitle as any, { opacity: [0, 1], y: [30, 0] }, { duration: 0.8, delay: stagger(0.15), ease: [0.22, 1, 0.36, 1] });
			}

			// Bento Grid Animation
			const bentoCards = document.querySelectorAll<HTMLElement>(".bg-surface-container-low.py-24 .group, .bg-surface-container-low.py-24 .bg-primary-container");
			bentoCards.forEach((el) => (el.style.opacity = "0"));
			inView(".bg-surface-container-low.py-24", () => {
				animate(bentoCards as any, { opacity: [0, 1], y: [30, 0] }, { duration: 0.7, delay: stagger(0.1), ease: [0.22, 1, 0.36, 1] });
			}, { margin: "-10%" });
		});
	</script>
</Layout>

<style>
/* Contenedores estáticos de las máscaras */
.spotlight-mask-base {
	position: absolute;
	inset: 0;
	z-index: 0;
	pointer-events: none;
	/* Máscara base muy tenue y apagada por defecto */
	mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.2) 10%, transparent 60%);
	-webkit-mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.2) 10%, transparent 60%);
}

.spotlight-mask-cursor {
	position: absolute;
	inset: 0;
	z-index: 0;
	pointer-events: none;
	/* Máscara spotlight vinculada a la posición del mouse */
	mask-image: radial-gradient(400px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), black 0%, transparent 100%);
	-webkit-mask-image: radial-gradient(400px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), black 0%, transparent 100%);
	opacity: 0;
	transition: opacity 0.5s ease;
}

#hero-section:hover .spotlight-mask-cursor {
	opacity: 1; /* El spotlight se enciende al entrar el mouse */
}

/* El grid arquitécnico infinito */
.architectural-grid {
	position: absolute;
	inset: -50%;
	/* Color sutil con un 5% de opacidad para que resalte sin tapar el texto */
	background-image: 
		linear-gradient(color-mix(in srgb, var(--color-on-surface) 5%, transparent) 1px, transparent 1px),
		linear-gradient(90deg, color-mix(in srgb, var(--color-on-surface) 5%, transparent) 1px, transparent 1px);
	background-size: 56px 56px;
	animation: panGrid 45s linear infinite;
	pointer-events: none;
}

@keyframes panGrid {
	0% { transform: translate(0, 0); }
	100% { transform: translate(56px, 56px); }
}

/* Floating tech badges around the portrait */
.hero-badge {
	animation: floatBadge 5s ease-in-out infinite;
}

@keyframes floatBadge {
	0%, 100% { transform: translateY(0); }
	50% { transform: translateY(-8px); }
}

/* Decorative rings: subtle counter-rotation */
.ring-dashed {
	animation: spinCW 22s linear infinite;
}
.ring-dotted {
	animation: spinCCW 34s linear infinite;
}

@keyframes spinCW {
	to { transform: rotate(360deg); }
}
@keyframes spinCCW {
	to { transform: rotate(-360deg); }
}
</style>
