---
import Layout from '../layouts/Layout.astro';
import { useTranslations, useTranslatedPath } from '../i18n/utils';
import { projects, techLabels, uniqueTechCount } from '../data/projects';

const t = useTranslations('es');
const translatePath = useTranslatedPath('es');
const lang = 'es' as const;
---

<Layout>
	<header class="pt-32 pb-20">
		<div class="flex flex-col md:flex-row md:items-end justify-between gap-8 max-w-7xl mx-auto px-8 md:px-12">
			<div class="max-w-2xl">
				<span class="font-headline uppercase tracking-widest text-primary-container text-xs mb-4 block">Lo Que He Construido</span>
				<h1 class="text-5xl md:text-7xl font-headline font-bold tracking-tighter text-on-surface leading-none">PROYECTOS.</h1>
				<p class="mt-6 text-on-surface-variant text-lg font-body leading-relaxed max-w-lg">
					Proyectos que fui construyendo mientras aprendía, cada uno resolviendo un problema distinto.
				</p>
			</div>
			<div class="flex gap-4">
				<div class="px-6 py-4 bg-surface-container-low rounded-sm">
					<span class="block text-2xl font-headline font-bold text-text-heading">{projects.length}</span>
					<span class="block font-headline text-[10px] text-on-surface-muted uppercase tracking-widest">Proyectos</span>
				</div>
				<div class="px-6 py-4 bg-surface-container-low rounded-sm">
					<span class="block text-2xl font-headline font-bold text-text-heading">{uniqueTechCount}</span>
					<span class="block font-headline text-[10px] text-on-surface-muted uppercase tracking-widest">Tecnologías</span>
				</div>
			</div>
		</div>
	</header>

	<section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 px-8 md:px-12 max-w-7xl mx-auto">
		{projects.map((project) => (
			<a
				href={project.hasDetailPage ? translatePath(`/projects/${project.projectCode}/`) : project.detailsUrl}
				target={project.hasDetailPage ? undefined : "_blank"}
				rel={project.hasDetailPage ? undefined : "noopener noreferrer"}
				class="group bg-surface-container rounded-md transition-colors duration-300 hover:bg-surface-container-high flex flex-col overflow-hidden"
			>
				<div class="h-48 overflow-hidden bg-surface-container-lowest">
					<img
						class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
						src={project.imageUrl}
						alt={project.texts[lang].title}
					/>
				</div>
				<div class="p-8 flex-1 flex flex-col justify-between">
					<div>
						<h3 class="text-xl font-headline font-bold text-text-heading mb-3 group-hover:text-primary-container transition-colors">
							{project.texts[lang].title}
						</h3>
						<p class="text-on-surface-variant font-body text-sm mb-6 leading-relaxed">
							{project.texts[lang].description}
						</p>
						<div class="flex flex-wrap gap-2 mb-6">
							{project.technologies.map((tech) => (
								<span class="px-3 py-1 bg-surface-container-lowest text-on-surface-variant text-[10px] font-headline rounded-sm uppercase">
									{techLabels[tech] ?? tech}
								</span>
							))}
						</div>
					</div>
					<div class="flex items-center gap-2 text-primary-container font-headline font-bold uppercase tracking-widest text-[10px]">
						VER DETALLES
						<span class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1">
							{project.hasDetailPage ? 'arrow_forward' : 'open_in_new'}
						</span>
					</div>
				</div>
			</a>
		))}
	</section>

	<script>
		import { animate, inView, stagger } from "motion";

		document.addEventListener("astro:page-load", () => {
			// Este listener queda activo en toda la navegación: solo actúa en el catálogo
			if (!document.querySelector("section.grid a.group")) return;

			const header = document.querySelector<HTMLElement>("header.pt-32");
			if (header) {
				header.style.opacity = "0";
				animate(header as any, { opacity: [0, 1], y: [20, 0] }, { duration: 0.8, ease: [0.22, 1, 0.36, 1] });
			}

			const projectCards = document.querySelectorAll<HTMLElement>("section.grid a.group");
			projectCards.forEach((el) => (el.style.opacity = "0"));

			inView("section.grid", () => {
				animate(projectCards as any, { opacity: [0, 1], y: [40, 0] }, { duration: 0.8, delay: stagger(0.1), ease: [0.22, 1, 0.36, 1] });
			}, { margin: "-10%" });
		});
	</script>
</Layout>
